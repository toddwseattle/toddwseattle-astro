{
  "name": "pw-toddwseattle-astro",
  "type": "module",
  "version": "0.0.1",
  "description": "Personal website migrated from Gatsby to Astro with TypeScript, Tailwind CSS, and Framer Motion",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,astro,json,md}\"",
    "deploy:staging": "firebase deploy --only hosting:staging",
    "deploy:prod": "firebase deploy --only hosting:prod",
    "build:deploy-staging": "npm run build && npm run deploy:staging",
    "ship:staging": "npm run test:run && npm run format && npm run build && npm run deploy:staging",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "ci": "npm ci && npm audit --audit-level=moderate && npx astro check && npm run test:run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ralph": "bash ./scripts/ralph.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-seo": "^1.2.0",
    "framer-motion": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reveal.js": "^6.0.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "baseline-browser-mapping": "^2.9.19",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "astro",
    "typescript",
    "tailwindcss",
    "personal-website"
  ],
  "license": "MIT"
}
