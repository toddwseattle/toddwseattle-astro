---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import Container from "../../components/ui/Container";
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import ResourceLayout from "../../layouts/materials/ResourceLayout.astro";
import ExampleLayout from "../../layouts/materials/ExampleLayout.astro";
import ExerciseLayout from "../../layouts/materials/ExerciseLayout.astro";
import PostLayout from "../../layouts/materials/PostLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("course-materials");
  const publishedEntries = entries.filter((entry) => entry.data.draft !== true);
  return publishedEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"course-materials">;
}

const { entry } = Astro.props as Props;
const { title, description, cover, type } = entry.data as any;
const rendered = await entry.render();

// Extract src from ImageMetadata object or use string directly
const coverSrc =
  cover && typeof cover === "object" && "src" in cover
    ? (cover as any).src
    : cover;
---

<BaseLayout
  title={title}
  description={description}
  image={coverSrc}
  article={true}
>
  <Header client:load />
  {
    type === "tutorial" ? (
      <TutorialLayout entry={entry} rendered={rendered} />
    ) : type === "resource" ? (
      <ResourceLayout entry={entry} rendered={rendered} />
    ) : type === "examples" ? (
      <ExampleLayout entry={entry} rendered={rendered} />
    ) : type === "exercise" ? (
      <ExerciseLayout entry={entry} rendered={rendered} />
    ) : type === "post" ? (
      <PostLayout entry={entry} rendered={rendered} />
    ) : (
      <article class="py-16">
        {coverSrc && (
          <div class="w-full mb-10 overflow-hidden rounded-xl bg-paper-200 dark:bg-graphite-700 aspect-video">
            <img
              src={coverSrc}
              alt={title}
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        )}
        <Container>
          <div class="max-w-3xl mx-auto">
            <a
              href="/teaching"
              class="inline-flex items-center text-ink-800 underline decoration-graphite-400 hover:decoration-ink-800 dark:text-paper-100 dark:hover:decoration-paper-100 mb-8 font-medium"
            >
              ← Back to Teaching
            </a>
            <header class="mb-8">
              <h1 class="mt-2 text-4xl md:text-5xl font-bold tracking-tight text-ink-800 dark:text-paper-100">
                {title}
              </h1>
              {description && (
                <p class="mt-4 text-xl text-ink-600 dark:text-paper-200">
                  {description}
                </p>
              )}
            </header>
            <div class="prose prose-lg dark:prose-invert max-w-none">
              <rendered.Content />
            </div>
            <div class="mt-12 pt-8 border-t border-graphite-600/20 dark:border-graphite-600">
              <a
                href="/teaching"
                class="inline-flex items-center text-ink-800 underline decoration-graphite-400 hover:decoration-ink-800 dark:text-paper-100 dark:hover:decoration-paper-100 font-medium"
              >
                ← Back to Teaching
              </a>
            </div>
          </div>
        </Container>
      </article>
    )
  }
  <Footer client:load />
</BaseLayout>
