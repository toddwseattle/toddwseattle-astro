---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import Container from "../../components/ui/Container";
import TitleSection from "../../components/ui/TitleSection";

const title = "About";
const description = "About Todd Warren - software leader, educator, advisor";
---

<BaseLayout title={title} description={description}>
  <Header client:load />
  <main class="py-16">
    <Container>
      <TitleSection
        client:load
        title="About"
        subtitle="Software leader, educator, advisor"
        center
      />
      <div class="mt-12 prose prose-lg max-w-prose mx-auto">
        <p>
          <strong>Todd Warren</strong> is a technology leader, consultant, and educator
          who splits his time between Seattle and Park City. He has over 30 years
          of experience in software development, management, and investment, including
          21 years at Microsoft where he became a corporate vice president.
        </p>

        <p>
          Todd teaches at Northwestern University's
          <a
            href="https://farley.northwestern.edu/"
            target="_blank"
            rel="noopener noreferrer"
            >Farley Center for Entrepreneurship and Innovation</a
          >, where he co-teaches a course on Corporate Innovation. He previously
          co-created the award-winning NUvention Web entrepreneurship course and
          has taught software engineering, product design, and web development
          at both Northwestern and
          <a
            href="https://www.ashesi.edu.gh/"
            target="_blank"
            rel="noopener noreferrer">Ashesi University</a
          > in Ghana.
        </p>

        <p>
          Beyond teaching, Todd consults with companies on software strategy and
          development through
          <a
            href="https://envorso.com/"
            target="_blank"
            rel="noopener noreferrer">Envorso</a
          >, and has worked with organizations ranging from Ford to early-stage
          startups. He is a founding trustee of the
          <a
            href="https://www.ashesifoundation.org/"
            target="_blank"
            rel="noopener noreferrer">Ashesi University Foundation</a
          >
          and serves on the board of
          <a
            href="https://venturewell.org/"
            target="_blank"
            rel="noopener noreferrer">VentureWell</a
          >, both focused on developing the next generation of entrepreneurial
          talent.
        </p>

        <p>
          When he's not working, Todd enjoys playing guitar and riding a tandem
          bicycle with his wife.
        </p>

        <p>
          For a consolidated view of experience, skills, and education, see the
          <a href="/resume/">resume</a>.
        </p>
      </div>
    </Container>
  </main>
  <Footer client:load />
</BaseLayout>
