---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import Container from "../../components/ui/Container";
import TitleSection from "../../components/ui/TitleSection";

const title = "AutoSoftToday";
const description =
  "Exploring the intersection of automotive technology and software";
---

<BaseLayout title={title} description={description}>
  <Header client:load />
  <main class="py-16">
    <Container>
      <TitleSection
        client:load
        title="AutoSoftToday"
        subtitle="Exploring the intersection of automotive technology and software"
        center
      />
      <div class="mt-12 prose prose-lg max-w-prose mx-auto">
        <p>
          AutoSoftToday started as a side project to automate the tracking of
          software related recalls. I built this astro based website to provide
          a centralized resource for automotive software information in April
          2025. When I was working at Ford, I was surprised by the number of
          software related recalls, and became curious about their frequency and
          impact.
        </p>
        <p>
          AutoSoftToday is a comprehensive resource tracking the intersection of
          automotive technology and software. The site provides real-time data
          on software recalls affecting vehicles worldwide, analyzing trends in
          over-the-air (OTA) updates, and exploring critical topics like
          electric vehicle safety, autonomous driving systems, and open-source
          software in automotive development.
        </p>
        <p>
          With detailed recall statistics, in-depth industry analysis, and news
          coverage of automotive software issues, AutoSoftToday helps vehicle
          owners, manufacturers, and technology enthusiasts understand the
          rapidly evolving landscape of software-defined vehicles.
        </p>
        <p>
          <a
            href="https://autosofttoday.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-800 underline decoration-graphite-400 hover:decoration-ink-800 font-medium"
          >
            Visit AutoSoftToday →
          </a>
        </p>
      </div>
    </Container>
  </main>
  <Footer client:load />
</BaseLayout>
