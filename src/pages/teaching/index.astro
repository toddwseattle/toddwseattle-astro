---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import Container from "../../components/ui/Container";
import TitleSection from "../../components/ui/TitleSection";
import CourseMaterialsList from "../../components/teaching/CourseMaterialsList.astro";

const title = "Teaching";
const description = "Courses on corporate innovation and software engineering";

// Fetch all courses and sort by title
const courses = await getCollection("teaching");
const sortedCourses = courses
  .filter((course) => course.data.draft !== true)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={title} description={description}>
  <Header client:load />
  <main class="py-16">
    <Container>
      <TitleSection
        client:load
        title="Teaching"
        subtitle="Courses on corporate innovation and software engineering"
        center
      />

      {/* Courses Grid */}
      <div
        class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto"
      >
        {
          sortedCourses.map((course) => (
            <a
              href={`/teaching/${course.slug}/`}
              class="group p-6 border border-graphite-600/20 dark:border-graphite-600 rounded-lg hover:shadow-lg hover:border-graphite-400 dark:hover:border-ink-600 transition-all duration-200"
            >
              <h3 class="text-xl font-semibold text-ink-800 dark:text-paper-100 group-hover:text-ink-800 underline decoration-graphite-400 hover:decoration-ink-800 transition-colors mb-2">
                {course.data.title}
              </h3>
              <p class="text-ink-600 dark:text-paper-200 mb-4 line-clamp-3">
                {course.data.description}
              </p>
              <div class="text-sm text-ink-800 underline decoration-graphite-400 hover:decoration-ink-800 dark:text-paper-100 dark:hover:decoration-paper-100 font-medium group-hover:translate-x-1 transition-transform">
                Learn more →
              </div>
            </a>
          ))
        }
      </div>

      {/* Quick Overview */}
      <div class="mt-16 max-w-3xl mx-auto prose prose-lg dark:prose-invert">
        <h2 class="text-2xl font-bold text-ink-800 dark:text-paper-100 mb-4">
          Why These Courses?
        </h2>
        <p class="text-ink-600 dark:text-paper-200">
          Whether you're building innovation within established organizations,
          launching new ventures, or developing software that scales—these
          courses provide practical frameworks, hands-on experience, and
          mentorship from practitioners.
        </p>
        <p class="text-ink-600 dark:text-paper-200">
          Each course combines theory with real-world application, emphasizing
          that deep understanding comes from doing.
        </p>
      </div>

      {/* All Course Materials */}
      <div class="mt-16">
        <h2
          class="text-3xl font-bold text-ink-800 dark:text-paper-100 mb-8 text-center"
        >
          All Course Materials & Resources
        </h2>
        <CourseMaterialsList />
      </div>
    </Container>
  </main>
  <Footer client:load />
</BaseLayout>
