---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import Container from "../../components/ui/Container";
import TitleSection from "../../components/ui/TitleSection";

const title = "Consulting";
const description = "Advisory services for innovation and software engineering";
---

<BaseLayout title={title} description={description}>
  <Header client:load />
  <main class="py-16">
    <Container>
      <TitleSection
        client:load
        title="Consulting"
        subtitle="Advisory services for innovation and software engineering"
        center
      />
      <div class="mt-12 prose prose-lg max-w-prose mx-auto">
        <p>
          Todd does consulting through
          <a href="https://envorso.com">Envorso</a>, where he is a senior
          advisor.
        </p>
        <p>Past engagements have included:</p>
        <ol>
          <li>
            Helping a major automotive manufacturer assess the integration of an
            acquired software development site with current operations.
          </li>
          <li>
            Advising on talent management, talent assessment, and organizational
            structure for software companies, and for manufacturing companies
            building software organizations.
          </li>
          <li>
            Acting as an interim executive to improve software operations,
            including project management, testing, talent, and supplier
            integration.
          </li>
          <li>
            Leading companies through strategic planning retreats using tools
            like scenario planning and the business model canvas.
          </li>
        </ol>
      </div>
    </Container>
  </main>
  <Footer client:load />
</BaseLayout>
