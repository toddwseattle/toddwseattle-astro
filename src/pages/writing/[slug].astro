---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header";
import Footer from "../../components/Footer";
import Container from "../../components/ui/Container";
import { calculateReadingTime, formatReadingTime } from "../../lib/readingTime";

const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const categoryLabels: Record<string, string> = {
  innovation: "Innovation & Org Design",
  "software-engineering": "Software Engineering",
  teaching: "Teaching Reflections",
  "automotive-software": "Automotive Software",
  cycling: "Cycling",
  music: "Guitar & Music",
};

const displayLabel = (value: string) => categoryLabels[slugify(value)] ?? value;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const published = posts.filter((post) => post.data.draft !== true);
  return published.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, date, tags, cover, category } = post.data;
const { Content } = await post.render();

// Calculate reading time from post body
const readingTime = formatReadingTime(calculateReadingTime(post.body ?? ""));

// Format date to readable format
const formatDate = (dateString: string) => {
  const d = new Date(dateString);
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Extract src for OG image metadata (needs string URL)
const coverSrc = cover?.src;

const tagLinks = Array.from(
  new Set([...(category ? [category] : []), ...(tags ?? [])].filter(Boolean)),
);
---

<BaseLayout
  title={title}
  description={description}
  image={coverSrc}
  article={true}
  publishedTime={date}
  tags={tagLinks}
>
  <Header client:load />
  <article class="py-16">
    {
      cover && (
        <div class="w-full md:w-1/2 mx-auto mb-10 overflow-hidden rounded-xl bg-paper-200 dark:bg-graphite-700 aspect-video">
          <Image
            src={cover}
            alt={title}
            width={1200}
            height={675}
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      )
    }

    <Container>
      <div class="max-w-3xl mx-auto">
        <a
          href="/writing"
          class="inline-flex items-center text-ink-800 dark:text-paper-100 underline decoration-graphite-400 hover:decoration-ink-800 dark:hover:decoration-paper-100 mb-8 font-medium"
          >&larr; Back to Writing</a
        >

        <header class="mb-8">
          <div
            class="flex items-center gap-2 text-sm text-graphite-400 font-medium"
          >
            <time datetime={date}>
              {formatDate(date)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{readingTime}</span>
          </div>

          <h1
            class="mt-2 text-4xl md:text-5xl font-bold tracking-tight text-ink-800 dark:text-paper-100"
          >
            {title}
          </h1>

          <p class="mt-4 text-xl text-ink-600 dark:text-paper-200">
            {description}
          </p>

          {
            tagLinks.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {tagLinks.map((tag) => (
                  <a
                    href={`/writing/tag/${slugify(tag)}/`}
                    class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-paper-200 text-ink-800 dark:bg-graphite-600 dark:text-paper-100 hover:bg-graphite-400/20 dark:hover:bg-ink-600 transition-colors"
                  >
                    {displayLabel(tag)}
                  </a>
                ))}
              </div>
            )
          }
        </header>

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

        <div
          class="mt-12 pt-8 border-t border-graphite-600/20 dark:border-graphite-600"
        >
          <a
            href="/writing"
            class="inline-flex items-center text-ink-800 dark:text-paper-100 underline decoration-graphite-400 hover:decoration-ink-800 dark:hover:decoration-paper-100 font-medium"
            >&larr; Back to all posts</a
          >
        </div>
      </div>
    </Container>
  </article>
  <Footer client:load />
</BaseLayout>
