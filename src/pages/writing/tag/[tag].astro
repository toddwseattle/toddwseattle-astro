---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header";
import Footer from "../../../components/Footer";
import TitleSection from "../../../components/ui/TitleSection";
import BlogGrid from "../../../components/blog/BlogGrid.astro";

const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const formatLabel = (value: string) =>
  value
    .replace(/[-_]+/g, " ")
    .split(" ")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

const categoryLabels: Record<string, string> = {
  innovation: "Innovation & Org Design",
  "software-engineering": "Software Engineering",
  teaching: "Teaching Reflections",
  "automotive-software": "Automotive Software",
  cycling: "Cycling",
  music: "Guitar & Music",
};

export async function getStaticPaths() {
  const slugifyLocal = (value: string) =>
    value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const formatLabelLocal = (value: string) =>
    value
      .replace(/[-_]+/g, " ")
      .split(" ")
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");

  const categoryLabelsLocal: Record<string, string> = {
    innovation: "Innovation & Org Design",
    "software-engineering": "Software Engineering",
    teaching: "Teaching Reflections",
    "automotive-software": "Automotive Software",
    cycling: "Cycling",
    music: "Guitar & Music",
  };

  const allPosts = await getCollection("blog");
  const publishedPosts = allPosts.filter((post) => post.data.draft !== true);
  const tagMap = new Map<string, string>();

  publishedPosts.forEach((post) => {
    if (post.data.category) {
      const categorySlug = slugifyLocal(post.data.category);
      if (!tagMap.has(categorySlug)) {
        tagMap.set(
          categorySlug,
          categoryLabelsLocal[categorySlug] ??
            formatLabelLocal(post.data.category),
        );
      }
    }

    (post.data.tags ?? []).forEach((tag) => {
      const tagSlug = slugifyLocal(tag);
      if (!tagMap.has(tagSlug)) {
        tagMap.set(tagSlug, formatLabelLocal(tag));
      }
    });
  });

  return [...tagMap.keys()].map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter((post) => post.data.draft !== true);

const filteredPosts = publishedPosts
  .filter((post) => {
    const categoryMatch = post.data.category
      ? slugify(post.data.category) === tag
      : false;
    const tagMatch = (post.data.tags ?? []).some(
      (item) => slugify(item) === tag,
    );
    return categoryMatch || tagMatch;
  })
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const tagLabel = tag ? (categoryLabels[tag] ?? formatLabel(tag)) : "Posts";
const tagDescription = tag
  ? `Posts tagged with ${tagLabel}`
  : "Posts tagged in Writing";
---

<BaseLayout
  title={`${tagLabel} | Writing`}
  description={tagDescription}
  noindex={true}
>
  <Header client:load />
  <main class="py-16">
    <TitleSection
      client:load
      title={tagLabel}
      subtitle={tagDescription}
      center
    />
    <div class="mt-4 mb-8 text-center">
      <a
        href="/writing/"
        class="inline-flex items-center text-ink-800 dark:text-paper-100 underline decoration-accent-teal hover:decoration-ink-800 dark:hover:decoration-paper-100"
      >
        <svg
          class="w-4 h-4 mr-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        View all posts
      </a>
    </div>
    <div class="mt-8">
      <BlogGrid posts={filteredPosts} />
    </div>
  </main>
  <Footer client:load />
</BaseLayout>
