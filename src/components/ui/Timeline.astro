---
interface Props {
  title: string;
  subtitle: string;
  startDate: string;
  endDate: string;
}

const { title, subtitle, startDate, endDate } = Astro.props;
---

<div
  class="flex flex-col sm:flex-row w-full p-4 relative border-l border-graphite-600/30 dark:border-graphite-600 last:pb-0"
>
  <span
    class="w-3 h-3 border border-graphite-600/30 dark:border-ink-600 bg-paper-200 dark:bg-graphite-700 rounded-full absolute -left-[6px] top-5"
  ></span>

  <div class="w-full sm:w-1/3">
    <div
      class="text-xs border border-graphite-400 dark:border-ink-600 text-graphite-400 dark:text-graphite-400 rounded-full px-2 w-fit mb-3"
    >
      {startDate} - {endDate}
    </div>
    <div class="font-semibold text-ink-800 dark:text-paper-100">
      {title}
    </div>
    <div class="text-xs text-graphite-400 dark:text-graphite-400 mt-1">
      {subtitle}
    </div>
  </div>

  <div
    class="w-full sm:w-2/3 mt-4 sm:mt-0 prose prose-sm max-w-none text-ink-600 dark:text-paper-200"
  >
    <slot />
  </div>
</div>
