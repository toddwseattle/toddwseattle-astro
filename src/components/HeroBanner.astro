---
import { getCollection } from 'astro:content';
import Container from './ui/Container';
import TitleSection from './ui/TitleSection';

const heroEntries = await getCollection('hero');
const hero = heroEntries[0];

if (!hero) {
  throw new Error('Hero content not found');
}

const { title, subtitle, content, linkTo, linkText } = hero.data;
---

<section class="bg-paper-100 dark:bg-graphite-700 py-16 md:py-24 border-b border-graphite-600/20 dark:border-graphite-600">
  <Container section client:load>
    <div class="max-w-3xl">
      <TitleSection title={title} subtitle={subtitle} client:load />
      <p class="text-lg text-ink-600 dark:text-paper-200 mb-8">
        {content}
      </p>
      <a
        href={linkTo}
        class="inline-block bg-ink-800 dark:bg-paper-100 text-paper-50 dark:text-ink-800 px-6 py-3 rounded-lg font-medium hover:bg-ink-950 dark:hover:bg-paper-200 transition-colors"
      >
        {linkText}
      </a>
    </div>
  </Container>
</section>
