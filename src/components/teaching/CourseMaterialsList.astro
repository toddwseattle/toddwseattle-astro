---
import { getCollection } from "astro:content";

interface Props {
  courseSlug?: string;
}

const { courseSlug } = Astro.props;

// Fetch and filter course materials
const allMaterials = await getCollection("course-materials");
const materials = allMaterials
  .filter(
    (material) =>
      material.data.draft !== true &&
      (courseSlug ? material.data.courses.includes(courseSlug) : true),
  )
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

// Extract unique material types for the filter dropdown
const materialTypes = [...new Set(materials.map((m) => m.data.type))].sort();

// Format date to readable format
const formatDate = (dateString: string) => {
  const d = new Date(dateString);
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Get badge classes for material type (monochrome)
const getTypeBadgeClasses = (_type: string) => {
  // All badges use monochrome styling per design system
  return "bg-paper-200 text-ink-800 dark:bg-graphite-600 dark:text-paper-100";
};

// Get badge classes for difficulty (monochrome)
const getDifficultyBadgeClasses = (_difficulty: string) => {
  // All badges use monochrome styling per design system
  return "bg-paper-200 text-ink-600 dark:bg-graphite-700 dark:text-paper-200";
};

// Extract src from ImageMetadata object or use string directly
const getCoverSrc = (cover: any) => {
  return cover && typeof cover === "object" && "src" in cover
    ? cover.src
    : cover;
};
---

{
  materials.length === 0 ? (
    <div class="text-center py-12 text-graphite-400">
      <p class="text-lg">No materials yet for this course. Check back soon!</p>
    </div>
  ) : (
    <div>
      {/* Filter Controls */}
      {materialTypes.length > 1 && (
        <div class="mb-8 flex items-center gap-3">
          <label for="type-filter" class="sr-only">
            Filter materials by type
          </label>
          <span class="font-sans text-sm font-medium text-ink-600 dark:text-paper-200">
            Filter by type:
          </span>
          <select
            id="type-filter"
            class="px-4 py-2 border border-graphite-600/30 rounded-lg focus:ring-2 focus:ring-accent-teal focus:border-graphite-400 dark:bg-surface-dark dark:border-graphite-600 dark:text-paper-100 transition-colors"
            aria-label="Filter materials by type"
          >
            <option value="all">All Materials</option>
            {materialTypes.map((type) => (
              <option value={type}>
                {type.charAt(0).toUpperCase() + type.slice(1)}
              </option>
            ))}
          </select>
        </div>
      )}

      {/* Materials Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {materials.map((material) => {
          const {
            title,
            description,
            type,
            difficulty,
            date,
            cover,
            timelineKey,
          } = material.data;
          const coverSrc = getCoverSrc(cover);

          return (
            <article
              class="material-card group relative bg-paper-50 dark:bg-surface-dark rounded-lg border border-graphite-600/20 dark:border-graphite-600 hover:border-graphite-400 dark:hover:border-ink-600 transition-all duration-300 overflow-hidden focus-within:ring-2 ring-accent-teal"
              data-type={type}
            >
              <a
                href={`/course-materials/${material.slug}`}
                aria-label={`Open ${title}`}
                class="block focus:outline-none"
              >
                {coverSrc && (
                  <div class="relative aspect-video w-full overflow-hidden bg-paper-200 dark:bg-graphite-700">
                    <img
                      src={coverSrc}
                      alt={title}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                )}

                <div class="p-6">
                  {/* Date */}
                  <time
                    datetime={date}
                    class="font-sans text-sm font-medium text-graphite-400"
                  >
                    {formatDate(date)}
                  </time>

                  {/* Title */}
                  <h3 class="mt-2 text-xl font-semibold text-ink-800 dark:text-paper-100 group-hover:underline transition-colors line-clamp-2">
                    {title}
                  </h3>

                  {/* Description */}
                  <p class="mt-3 text-ink-600 dark:text-paper-200 line-clamp-3">
                    {description}
                  </p>

                  {/* Badges */}
                  <div class="mt-4 flex flex-wrap gap-2">
                    {/* Type Badge */}
                    <span
                      class={`inline-flex items-center px-2.5 py-0.5 rounded-full font-sans text-xs font-medium ${getTypeBadgeClasses(type)}`}
                    >
                      {type.charAt(0).toUpperCase() + type.slice(1)}
                    </span>

                    {/* Difficulty Badge */}
                    {difficulty && (
                      <span
                        class={`inline-flex items-center px-2.5 py-0.5 rounded-full font-sans text-xs font-medium ${getDifficultyBadgeClasses(difficulty)}`}
                      >
                        {difficulty.charAt(0).toUpperCase() +
                          difficulty.slice(1)}
                      </span>
                    )}
                    {timelineKey && (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-sans text-xs font-medium bg-paper-200 text-ink-800 dark:bg-graphite-600 dark:text-paper-100">
                        Interactive
                      </span>
                    )}
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  )
}

<script>
  const filterSelect = document.getElementById(
    "type-filter",
  ) as HTMLSelectElement;
  const materialCards = document.querySelectorAll(".material-card");

  if (filterSelect && materialCards.length > 0) {
    filterSelect.addEventListener("change", (e) => {
      const selectedType = (e.target as HTMLSelectElement).value;

      materialCards.forEach((card) => {
        const cardType = card.getAttribute("data-type");

        if (selectedType === "all" || cardType === selectedType) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    });
  }
</script>
