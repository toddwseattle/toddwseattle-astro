---
import type { CollectionEntry, RenderResult } from "astro:content";
import Container from "../../components/ui/Container";
import CourseTimeline from "../../components/CourseTimeline";
import { getTimelineByKey } from "../../data/timelines";

interface Props {
  entry: CollectionEntry<"course-materials">;
  rendered: RenderResult;
}

const { entry, rendered } = Astro.props as Props;

if (!entry.data.timelineKey) {
  throw new Error("TimelineLayout requires entry.data.timelineKey.");
}

const timeline = getTimelineByKey(entry.data.timelineKey);
---

<article class="py-16">
  <Container>
    <div class="max-w-5xl mx-auto">
      <div class="prose prose-lg max-w-none">
        <rendered.Content />
      </div>

      <CourseTimeline timeline={timeline} client:load />
    </div>
  </Container>
</article>
