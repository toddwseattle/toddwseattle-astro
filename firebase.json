{
  "hosting": [
    {
      "target": "staging",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/_astro/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/blog",
          "destination": "/writing/",
          "type": 301
        },
        {
          "source": "/blog/",
          "destination": "/writing/",
          "type": 301
        },
        {
          "source": "/blog/**",
          "destination": "/writing/:splat/",
          "type": 301
        }
      ]
    },
    {
      "target": "prod",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/_astro/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/blog",
          "destination": "/writing/",
          "type": 301
        },
        {
          "source": "/blog/",
          "destination": "/writing/",
          "type": 301
        },
        {
          "source": "/blog/**",
          "destination": "/writing/:splat/",
          "type": 301
        }
      ]
    }
  ]
}
